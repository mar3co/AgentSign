PORT=3000
# Offline dev: DEV_OFFLINE=1 with no DATABASE_URL / SUPABASE_* gives `pnpm dev`
# a fake login (any email + any password) and an embedded PGlite DB in .dev/.
# Mail bodies (OTP codes, signing links) print to the dev console as [mail:body].
# Ignored on Vercel and in production builds. Magic links and OAuth need Supabase.
# DEV_OFFLINE=1
# Supabase Postgres URI. On Vercel the Supabase integration sets POSTGRES_URL
# (transaction pooler); the app uses that when DATABASE_URL is empty.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage bucket (create it in Supabase before deploying)
STORAGE_BUCKET=documents
# local dogfood filesystem blobs (ignored when VERCEL=1; use Supabase Storage there)
STORAGE_DIR=./var/blobs
# public origin for links in email (invites, completion, reminders)
APP_URL=http://localhost:3000
APP_ORIGIN=
RESEND_API_KEY=
FROM_EMAIL=sign@localhost
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
CRON_SECRET=
# AES-GCM key material for webhook secrets and /s/ token_enc (falls back to CRON_SECRET).
# Required to send documents with a human party.
WEBHOOK_KEK=
SIGNING_WINDOW_DAYS=7
FREE_KEEP_DAYS=7
PRO_KEEP_DAYS=365
FREE_SEND_LIMIT=20
FREE_SEND_WINDOW_DAYS=30
# PKCS#12 that seals PDFs. One of the two is required in production; empty is
# allowed in next dev (throwaway cert). Vercel has no file to point P12_PATH
# at, so the cloud uses P12_BASE64. A self-signed cert is fine (same class as
# DocuSeal's default):
#   openssl req -x509 -newkey rsa:2048 -days 3650 -subj "/CN=AgentSign/O=AgentSign" \
#     -keyout seal.key -out seal.crt -nodes
#   openssl pkcs12 -export -inkey seal.key -in seal.crt -out seal.p12 -passout pass:PASS
#   base64 -i seal.p12 | tr -d '\n'   # -> P12_BASE64
P12_PATH=
P12_BASE64=
P12_PASSPHRASE=
# SELF_HOST=1
# Feature flags live in the Vercel dashboard (vercel flags list). Deployments read
# them through the FLAGS connection string Vercel injects; nothing to set here.
# The SIGN_FLAG_* overrides below are for local dev and tests only. Setting one
# in a deployment takes that flag away from the dashboard.
# SIGN_FLAG_AGENT_PARTIES=1
# SIGN_FLAG_AGENT_ONLY_ATTEST=0
# SIGN_FLAG_AI_FIELD_DETECT=1
# Vercel AI Gateway key for AI field detection. Deployments authenticate with
# the OIDC token Vercel injects, so this is only needed for local dev.
AI_GATEWAY_API_KEY=
# shadcn studio premium registry (dev-only, used by `npx shadcn add @ss-blocks/...`)
SHADCN_STUDIO_EMAIL=
SHADCN_STUDIO_LICENSE_KEY=
